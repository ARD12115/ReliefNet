# Server Environment Variables
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (Aiven PostgreSQL)
# Format: postgresql://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
# Example from Aiven:
# DATABASE_URL=postgresql://avnadmin:<password>@postgresql-phoenixeyev5-11e7.j.aivencloud.com:27571/defaultdb?sslmode=require
DATABASE_URL=postgresql://postgres:***@localhost:5432/reliefnet
# For Aiven, set DB_SSL_REQUIRED=true and provide DB_CA_CERT if using a CA certificate file
DB_SSL_REQUIRED=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Valkey / Redis (Aiven Valkey compatible — works with the `redis` npm package)
# Format: rediss://default:***@<host>:<port>
# Example from Aiven:
# REDIS_URL=rediss://default:***@valkey-phoenixeyev5-11e7.d.aivencloud.com:27572
# Note: Variable name kept as REDIS_URL for compatibility with `redis` npm package
# which is wire-compatible with Valkey
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# JWT - GENERATE NEW SECRETS FOR PRODUCTION!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OSRM Routing
OSRM_URL=http://localhost:5000

# Matching Engine
MAX_MATCH_DISTANCE_KM=100
MATCHING_CRON_INTERVAL=5m

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# CORS - Comma-separated list of allowed origins (no trailing slashes)
# In production, set to your actual domain(s): https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://reliefnet-lake.vercel.app

# ============================================================================
# RELIEFNET — CLIENT ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to client/.env and fill in the REQUIRED values marked below.
# Vite variables must be prefixed with VITE_ to be exposed to the client.

# Backend API base URL (REQUIRED — set to your deployed backend in production)
VITE_API_URL=http://localhost:4000/api

# Socket.IO server URL (REQUIRED — set to your deployed backend in production)
VITE_SOCKET_URL=http://localhost:4000

# Server base URL for Socket.IO connections (REQUIRED — set to your deployed backend in production)
VITE_SERVER_URL=http://localhost:4000